// Title: Owner or other privileged Azure role assigned
// Id: AZ-002
// Severity: High
// Tactics: Persistence, PrivilegeEscalation
// Techniques: T1098
// Sub-techniques: T1098.003
// Tables: AzureActivity
// Frequency: PT1H
// Period: PT1H
// Entities: Account(FullName=Caller); IP(Address=CallerIpAddress); AzureResource(ResourceId=Scope)
// Custom details: RoleName, PrincipalId, PrincipalType
// Description: Someone assigned Owner, User Access Administrator, Role Based Access Control
//   Administrator or Contributor on an Azure scope. The first three can grant any other role, so a
//   new assignment is both an escalation and a way back in after the original account is cleaned up.
// False positives: Planned access changes, new subscriptions, and Privileged Identity Management
//   activating a role (the caller is then the PIM service).
// Tuning: Remove Contributor from PrivilegedRoleIds if it is assigned too often to be useful. Add
//   the identities that manage access to AllowedCallers.
// Response: Look up PrincipalId in Entra ID and confirm the assignment with the caller. If it was
//   not approved, remove it and review everything the caller and the principal did since.
// References: https://learn.microsoft.com/azure/role-based-access-control/built-in-roles
let PrivilegedRoleIds = dynamic({
    "8e3af657-a8ff-443c-a75c-2fe8c4bcb635": "Owner",
    "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9": "User Access Administrator",
    "f58310d9-a9f6-439a-9e8d-f62e7b41a168": "Role Based Access Control Administrator",
    "b24988ac-6180-42a0-ab88-20f7382dd24c": "Contributor"});
let AllowedCallers = dynamic([]);
let Writes = AzureActivity
    | where TimeGenerated > ago(1h)
    | where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE";
let Succeeded = Writes
    | where ActivityStatusValue =~ "Success"
    | distinct CorrelationId;
Writes
// The request (which role, for whom) is only in the record written when the operation starts.
| where ActivityStatusValue =~ "Start"
| where CorrelationId in (Succeeded)
| where tolower(Caller) !in (AllowedCallers)
| extend Request = coalesce(tostring(Properties_d), Properties)
| extend RoleDefinitionId = tolower(extract(@"(?i)roleDefinitions/([0-9a-f\-]{36})", 1, Request)),
         PrincipalId = extract(@"(?i)principalId\W+([0-9a-f\-]{36})", 1, Request),
         PrincipalType = extract(@"(?i)principalType\W+(\w+)", 1, Request)
| extend RoleName = tostring(PrivilegedRoleIds[RoleDefinitionId])
| where isnotempty(RoleName)
| extend Scope = tostring(split(tolower(_ResourceId), "/providers/microsoft.authorization/roleassignments")[0])
| project TimeGenerated, Caller, CallerIpAddress, RoleName, PrincipalId, PrincipalType, Scope, SubscriptionId,
          ResourceGroup, CorrelationId
