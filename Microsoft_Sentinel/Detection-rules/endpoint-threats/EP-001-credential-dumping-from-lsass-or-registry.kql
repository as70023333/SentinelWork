// Title: Credential dumping from LSASS or the registry
// Id: EP-001
// Severity: High
// Tactics: CredentialAccess
// Techniques: T1003
// Sub-techniques: T1003.001, T1003.002
// Tables: DeviceProcessEvents
// Frequency: PT1H
// Period: PT2H
// Entities: Host(FullName=DeviceName); Account(Name=AccountName, NTDomain=AccountDomain); Process(CommandLine=ProcessCommandLine); FileHash(Algorithm=HashAlgorithm, Value=ToolSHA256)
// Custom details: Method, FileName, InitiatingProcess
// Description: A process command line matches a well known way of stealing credentials from a Windows
//   device: dumping the memory of lsass.exe with ProcDump (also when renamed) or comsvcs.dll, running
//   Mimikatz style commands, or saving the SAM, SECURITY and SYSTEM registry hives. Credentials taken
//   this way are what an intruder uses to move to the next machine. The file hash is attached only
//   when the tool is not part of Windows, so nobody is tempted to block reg.exe or rundll32.exe.
// False positives: Rare. A support engineer capturing an LSASS dump for Microsoft support, a red team
//   exercise, or backup software that saves registry hives.
// Tuning: Exclude a named backup or forensic tool by its InitiatingProcessFileName and signer rather
//   than by device.
// Response: Isolate the device. Assume every account that signed in to it is exposed and reset those
//   passwords, starting with administrators. Collect the dump file path from the command line.
// References: https://attack.mitre.org/techniques/T1003/
DeviceProcessEvents
| where TimeGenerated > ago(2h)
// Rows are chosen by when they reached the workspace, so one that arrives late is not missed.
| where ingestion_time() > ago(65m) and ingestion_time() <= ago(5m)
| where FileName =~ "reg.exe"
    or ProcessCommandLine has_any ("lsass", "comsvcs", "sekurlsa", "lsadump", "Invoke-Mimikatz", "nanodump", "Out-Minidump")
| extend Method = case(
    (FileName in~ ("procdump.exe", "procdump64.exe") or ProcessVersionInfoOriginalFileName =~ "procdump") and ProcessCommandLine has "lsass", "ProcDump against LSASS",
    FileName =~ "rundll32.exe" and ProcessCommandLine has "comsvcs" and (ProcessCommandLine has "MiniDump" or ProcessCommandLine contains "#24"), "comsvcs.dll MiniDump",
    ProcessCommandLine contains "sekurlsa::" or ProcessCommandLine contains "lsadump::" or ProcessCommandLine has_any ("Invoke-Mimikatz", "nanodump", "Out-Minidump"), "Mimikatz style command",
    FileName =~ "reg.exe" and ProcessCommandLine has "save" and ProcessCommandLine matches regex @"(?i)\b(hklm|hkey_local_machine)\\(sam|security|system)(\s|""|$)", "Registry hive saved with reg.exe",
    "")
| where isnotempty(Method)
| project TimeGenerated, DeviceName, DeviceId, AccountName, AccountDomain, Method, FileName, FolderPath,
          ProcessCommandLine, SHA256,
          ToolSHA256 = iff(FileName in~ ("reg.exe", "rundll32.exe", "powershell.exe", "pwsh.exe", "cmd.exe"), "", SHA256),
          HashAlgorithm = "SHA256", InitiatingProcess = InitiatingProcessFileName, InitiatingProcessCommandLine,
          ReportId
