// Title: PowerShell with an encoded command or an in-memory download
// Id: EP-004
// Severity: Medium
// Tactics: Execution, DefenseEvasion, CommandAndControl
// Techniques: T1059, T1027, T1105
// Sub-techniques: T1059.001
// Tables: DeviceProcessEvents
// Frequency: PT1H
// Period: PT1H
// Entities: Host(FullName=DeviceName); Account(Name=AccountName, NTDomain=AccountDomain); Process(CommandLine=ProcessCommandLine)
// Custom details: Reason, InitiatingProcess, Executions
// Description: PowerShell ran with a long Base64 encoded command, or downloaded content and ran it
//   straight from memory or in a hidden window. Both keep the real script off disk and out of sight,
//   which is why loaders and hands-on intruders use them.
// False positives: Management agents run encoded PowerShell all day. The common ones (Configuration
//   Manager, Intune, Defender, Azure guest agents) are excluded by parent process; yours may differ.
// Tuning: Add your management tool's parent process to ManagementParents. Review the alerts for a
//   week before raising the severity.
// Response: Decode the command (the rule shows it in full). If it downloads from an address you do
//   not know, isolate the device and look for the same address on other devices.
// References: https://attack.mitre.org/techniques/T1059/001/
let ManagementParents = dynamic(["ccmexec.exe", "agentexecutor.exe", "microsoft.management.services.intunewindowsagent.exe",
                                 "senseir.exe", "sensecm.exe", "gc_worker.exe", "gc_service.exe", "monitoringhost.exe",
                                 "windowsazureguestagent.exe", "waappagent.exe"]);
DeviceProcessEvents
| where TimeGenerated > ago(1h)
| where FileName in~ ("powershell.exe", "pwsh.exe", "powershell_ise.exe")
| where tolower(InitiatingProcessFileName) !in (ManagementParents)
| extend Encoded = ProcessCommandLine matches regex @"(?i)\s[-/]e[a-z]*\s+[a-z0-9+/=]{40,}",
         Download = ProcessCommandLine has_any ("DownloadString", "DownloadFile", "DownloadData", "Net.WebClient",
                                                "Invoke-WebRequest", "Invoke-RestMethod", "Start-BitsTransfer"),
         RunsInMemory = ProcessCommandLine has_any ("IEX", "Invoke-Expression", "FromBase64String"),
         HiddenWindow = ProcessCommandLine matches regex @"(?i)\s[-/]w[a-z]*\s+(hidden|h|1)\b"
| extend Reason = case(Encoded, "Encoded command",
                       Download and RunsInMemory, "Download run from memory",
                       Download and HiddenWindow, "Download in a hidden window",
                       "")
| where isnotempty(Reason)
| summarize Executions = count(),
            arg_min(TimeGenerated, AccountName, AccountDomain, InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId)
            by DeviceName, DeviceId, Reason, ProcessCommandLine
| project TimeGenerated, DeviceName, DeviceId, AccountName, AccountDomain, Reason, ProcessCommandLine, Executions,
          InitiatingProcess = InitiatingProcessFileName, InitiatingProcessCommandLine, ReportId
