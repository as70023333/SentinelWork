// Title: New secret or certificate added to an application or service principal
// Id: PA-002
// Severity: Medium
// Tactics: Persistence, PrivilegeEscalation
// Techniques: T1098
// Sub-techniques: T1098.001
// Tables: AuditLogs
// Frequency: PT1H
// Period: PT2H
// Entities: Account(FullName=Actor); IP(Address=ActorIP); CloudApplication(Name=ApplicationName)
// Custom details: CredentialType, Operation, ApplicationObjectId
// Description: A client secret or certificate was added to an app registration or service principal.
//   Whoever holds the new credential can sign in as that application with its permissions, without a
//   user or MFA, and keeps that access after the user account that added it is cleaned up. The rule
//   compares the credentials before and after the change, so a credential swapped for another one is
//   reported and a removal is not.
// False positives: Developers and pipelines rotating secrets before they expire; onboarding a new
//   integration.
// Tuning: Add your deployment identities to AllowedActors. Consider raising the severity for
//   applications that hold directory or mail permissions.
// Response: Ask the application owner whether the credential was expected. If not, remove it, review
//   the service principal's sign-ins since it was added, and investigate the Actor account.
// References: https://learn.microsoft.com/entra/architecture/security-operations-applications
let AllowedActors = dynamic([]);
AuditLogs
| where TimeGenerated > ago(2h)
// Events are chosen by when they reached the workspace, so a late one is still read exactly once.
| where ingestion_time() > ago(1h)
| where LoggedByService =~ "Core Directory" and Category =~ "ApplicationManagement" and Result =~ "success"
// Any operation that changes the list of credentials (KeyDescription) is of interest.
| mv-apply Property = TargetResources[0].modifiedProperties on (
    where tostring(Property.displayName) == "KeyDescription"
    | project NewKeySet = parse_json(tostring(Property.newValue)),
              OldKeySet = parse_json(tostring(Property.oldValue)))
| extend AddedKeys = set_difference(NewKeySet, coalesce(OldKeySet, dynamic([])))
| where array_length(AddedKeys) > 0
| extend AddedCredentials = tostring(AddedKeys)
| extend ApplicationName = tostring(TargetResources[0].displayName),
         ApplicationObjectId = tostring(TargetResources[0].id),
         CredentialType = case(AddedCredentials contains "KeyType=Password", "Client secret",
                               AddedCredentials contains "KeyType=AsymmetricX509Cert", "Certificate",
                               "Other"),
         Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
         ActorIP = tostring(InitiatedBy.user.ipAddress)
| where Actor !in~ (AllowedActors)
| project TimeGenerated, ApplicationName, ApplicationObjectId, CredentialType, Operation = OperationName, Actor,
          ActorIP, AddedCredentials, CorrelationId
