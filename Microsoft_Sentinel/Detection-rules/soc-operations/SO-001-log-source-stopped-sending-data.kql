// Title: Log source stopped sending data
// Id: SO-001
// Severity: Medium
// Tactics: DefenseEvasion
// Techniques: T1562
// Sub-techniques: T1562.008
// Tables: Usage
// Frequency: PT6H
// Period: P7D
// Incidents: CustomDetails(DataType), P1D
// Custom details: DataType, HoursSilent, LastRecord, AverageDailyMB
// Description: A table that the detection rules depend on received data on most of the last seven
//   days and has received nothing for several hours. Every rule that reads the table is blind until
//   it is fixed, and nothing else will tell you, because a rule with no data raises no alerts.
// False positives: A source that is quiet out of hours (email on a public holiday), a planned
//   connector change, or a table you list in WatchedTables but only use occasionally.
// Tuning: Edit WatchedTables to the tables your rules read. Raise QuietHours for sources that are
//   naturally bursty.
// Response: Open the data connector page for the source, check its health and any recent change to
//   the connector, agent, diagnostic setting or data collection rule.
// References: https://learn.microsoft.com/azure/sentinel/monitor-data-connector-health
let WatchedTables = dynamic(["SigninLogs", "AuditLogs", "AzureActivity", "CommonSecurityLog", "Syslog",
                             "DeviceProcessEvents", "DeviceFileEvents", "DeviceEvents", "EmailEvents",
                             "UrlClickEvents", "CloudAppEvents"]);
let QuietHours = 6;
Usage
| where TimeGenerated > ago(7d)
| where DataType in (WatchedTables)
| summarize LastRecord = max(TimeGenerated),
            ActiveDays = dcount(bin(TimeGenerated, 1d)),
            AverageDailyMB = round(sum(Quantity) / 7.0, 1)
            by DataType
| where ActiveDays >= 5
| extend HoursSilent = datetime_diff("hour", now(), LastRecord)
| where HoursSilent >= QuietHours
| project DataType, LastRecord, HoursSilent, ActiveDays, AverageDailyMB
