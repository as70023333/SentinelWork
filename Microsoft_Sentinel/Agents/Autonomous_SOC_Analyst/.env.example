# =============================================================================
#  Autonomous SOC Analyst - configuration
#  Copy to .env and edit. Demo mode needs NOTHING from this file changed.
# =============================================================================

# ---------------------------------------------------------------- mode
# demo = simulated tenant, safe, offline (default)
# live = real Microsoft Sentinel / Defender / Entra ID. Read the README "Going live" first.
SOC_MODE=demo

# Shared secret required for the webhook and every write action (approve, rollback...).
# REQUIRED in live mode. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SOC_WEBHOOK_KEY=
# true = anyone who can reach the dashboard can read incidents (actions still need the key)
SOC_DASHBOARD_PUBLIC=true
SOC_PORT=8080
# Public URL of this service, used for links in Teams/webhook notifications
SOC_PUBLIC_URL=

# Simulated API latency in demo mode (makes the 28-second story realistic)
DEMO_LATENCY=true

# ---------------------------------------------------------------- time budget
FAST_PATH_BUDGET_SECONDS=28
AGENT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- Claude (optional, both modes)
# Without a key the report is written from a template. With a key, Claude writes the
# executive summary, attack narrative and next steps. Facts and actions stay deterministic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=12

# ---------------------------------------------------------------- Microsoft (live mode)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Set true when running in Azure with a managed identity instead of a client secret
USE_MANAGED_IDENTITY=false

SENTINEL_SUBSCRIPTION_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=
# Log Analytics "Workspace ID" (a GUID, on the workspace Overview page)
SENTINEL_WORKSPACE_ID=
# Update status/severity/labels and post the IR report as a comment on the Sentinel incident
WRITE_BACK_TO_SENTINEL=true

# How new incidents reach the agent:
#   POLL_SENTINEL=true  -> the agent polls Sentinel for New incidents (simplest, no Logic App)
#   POLL_SENTINEL=false -> a Sentinel automation rule + Logic App calls /api/webhook/sentinel
POLL_SENTINEL=false
POLL_INTERVAL_SECONDS=30

# ---------------------------------------------------------------- containment backends
# entra  = disable users in Entra ID (cloud-only users)
# onprem = disable users in Active Directory via an Azure Automation runbook
# both   = synced users -> AD, cloud users -> Entra ID; sessions always revoked in Entra ID
IDENTITY_BACKEND=entra
AD_AUTOMATION_WEBHOOK_URL=

# defender = Defender for Endpoint custom indicators (blocks on every onboarded device)
# webhook  = POST block requests to your firewall automation (see README)
# both     = both of the above
FIREWALL_BACKEND=defender
FIREWALL_WEBHOOK_URL=
FIREWALL_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- threat intel (live mode)
# Every feed is optional. Configure as many as you have keys for.
# Microsoft Defender TI + any feed connected to Sentinel (ThreatIntelIndicators table):
TI_USE_DEFENDER=true
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=
# abuse.ch Auth-Key: enables MalwareBazaar and URLhaus
ABUSECH_AUTH_KEY=

# ---------------------------------------------------------------- notifications
# Teams: channel -> Workflows -> "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=
# Receives every event as JSON (ServiceNow, Jira, Slack bridge, SOAR...)
GENERIC_WEBHOOK_URL=
# Receives ONLY page events (PagerDuty / Opsgenie / on-call bridge)
PAGER_WEBHOOK_URL=
